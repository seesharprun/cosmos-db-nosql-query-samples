{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NoSQLQueryReference",
  "type": "object",
  "required": [
    "name",
    "group",
    "description",
    "syntax",
    "arguments",
    "returns",
    "examples"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "enum": [
        "aggregation",
        "array",
        "conditional",
        "date-and-time",
        "full-text-search",
        "item",
        "mathematical",
        "spatial",
        "string",
        "type-checking",
        "clause"
      ]
    },
    "description": {
      "type": "string",
      "pattern": "^The `[A-Za-z0-9\\s_]+` (function|clause|keyword) (returns|calculates|converts|identifies|collects) .*"
    },
    "summary": {
      "type": "string"
    },
    "syntax": {
      "type": "string"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "argumentsNote": {
      "type": "string"
    },
    "returns": {
      "type": "string",
      "pattern": "^Returns .*"
    },
    "returnsNote": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description",
          "query",
          "result"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "pattern": "^In this example, .*"
          },
          "query": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "additionalProperties": false
    },
    "examplesSample": {
      "type": "object",
      "required": [
        "set",
        "query"
      ],
      "properties": {
        "set": {
          "type": "string",
          "enum": [
            "products",
            "employees"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "remarks": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "INCLUDE-RECOMMEND-RANGE-INDEX",
              "INCLUDE-NOTIFY-NO-INDEX-USAGE",
              "INCLUDE-NOTIFY-BINDING-STATIC",
              "INCLUDE-DATE-FORMAT-ISO-8601-UNDEFINED",
              "INCLUDE-DATE-FORMAT-ISO-8601-PARTS"
            ]
          }
        ]
      }
    },
    "related": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "system": {
      "type": "array",
      "items": {
        "enum": [
          "SKIP-VALIDATION"
        ]
      }
    }
  },
  "additionalProperties": false
}